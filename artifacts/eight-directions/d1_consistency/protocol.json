  "intervention": {
    "name": "one_share_full_position_consistency",
    "quantity": 1,
    "margin": 0.02,
    "flat_values": "do_nothing=0; buy_o=p_o-buy_cost(shown_o)",
    "held_values": "keep=0; close=sell_proceeds(shown_held)-p_held; switch_o=sell_proceeds(shown_held)-p_held+p_o-buy_cost(shown_o)",
    "rule": "Choose first maximum in legacy legal_actions order only if value exceeds no-op by strictly more than 0.02; otherwise no-op. Invalid frozen forecast uses no-op. Every selected action executed at historical delayed fill with legacy scoring; no new fill cap.",
